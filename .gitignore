# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# salida local del script de prueba del pipeline (scripts/test-pipeline.ts)
/scripts/atomivid-test-output.mp4

# estado de runtime del cost guard de Long Form (registro real de gasto por
# video — nunca contenido editorial, nunca debe versionarse) — ver
# src/lib/video/long-form/video-cost-guard.ts
/.atomivid-state/

# typescript
*.tsbuildinfo
next-env.d.ts
