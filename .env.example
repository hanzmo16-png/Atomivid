NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role key de Supabase (Project Settings → API → service_role).
# NUNCA la expongas al cliente ni la prefijes con NEXT_PUBLIC_. Solo se usa
# en el pipeline de generación de video (servidor).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Guion (Claude / Anthropic). https://console.anthropic.com
ANTHROPIC_API_KEY=tu-anthropic-api-key
# Opcional — modelo usado para generar el guion (por defecto uno económico,
# ver notas de presupuesto en el README).
ANTHROPIC_SCRIPT_MODEL=claude-sonnet-5

# Voz IA (ElevenLabs). https://elevenlabs.io
ELEVENLABS_API_KEY=tu-elevenlabs-api-key
# Opcional — ID de una voz de tu cuenta de ElevenLabs (por defecto "Roger",
# una voz "premade" incluida gratis; las voces de la Voice Library de
# ElevenLabs, como "Rachel", requieren plan de pago para usarse por API).
ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
# Opcional — voces específicas por idioma (el usuario elige español/inglés
# en /dashboard/new). "Roger" narra en inglés con acento correcto pero no
# es nativo en español; configura estas para pronunciación más natural en
# cada idioma. Si no las configuras, cae a ELEVENLABS_VOICE_ID en ambos
# idiomas (funcional, no óptimo).
ELEVENLABS_VOICE_ID_ES=
ELEVENLABS_VOICE_ID_EN=
# Opcional — modelo de menor costo/latencia de ElevenLabs.
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Footage/imágenes (Pexels, banco gratuito). https://www.pexels.com/api
PEXELS_API_KEY=tu-pexels-api-key

# Música de fondo: ni Pixabay Music ni Freesound tienen hoy una API lista
# para uso comercial sin pasos extra (ver README → "Música de fondo").
# Deja vacío para usar el proveedor "fixture" (tono suave generado, sin
# licencia real). Como alternativa real y gratuita: descarga manualmente
# varias pistas de Pixabay Music o Mixkit (ambas permiten uso comercial sin
# costo), súbelas a tu bucket de Supabase Storage (u otra URL pública) y
# apunta MUSIC_TRACK_URLS a la lista separada por comas (se elige una al
# azar por video) — o MUSIC_TRACK_URL para una sola pista fija.
MUSIC_TRACK_URL=
MUSIC_TRACK_URLS=

# --- Proveedores de cada etapa del pipeline ---
# Cada etapa (guion/voz/footage/música) tiene un proveedor "real" (llama a
# la API externa) y uno "fixture" (determinístico, sin red — útil para
# probar todo el flujo sin claves, ver `npm run test:pipeline`).
# Por defecto se auto-detecta: si falta la API key correspondiente, usa el
# fixture automáticamente. Fuerza uno explícitamente si lo necesitas:
# SCRIPT_PROVIDER=anthropic|fixture
# VOICE_PROVIDER=elevenlabs|fixture
# FOOTAGE_PROVIDER=pexels|fixture
# MUSIC_PROVIDER=custom|fixture
SCRIPT_PROVIDER=
VOICE_PROVIDER=
FOOTAGE_PROVIDER=
MUSIC_PROVIDER=

# --- Worker de render en segundo plano ---
# El render (voz/footage/música/ensamblado) puede tardar más que el límite
# de una función serverless. Por defecto se dispara un workflow de GitHub
# Actions (.github/workflows/render.yml) que hace el trabajo pesado fuera
# de Vercel; si faltan estas dos variables, cae automáticamente al worker
# "inline" (corre en el mismo proceso — solo para desarrollo/pruebas, ver
# README → "Worker en background").
#
# GH_WORKER_TOKEN: Personal Access Token de GitHub con permiso para
# disparar workflows en este repo (fine-grained: "Actions: Read and
# write"; classic: scope "repo"). NUNCA lo pongas en este archivo — solo
# en las variables de entorno de Vercel.
GH_WORKER_TOKEN=
# GH_WORKER_REPO: "owner/repo" del repositorio donde vive
# .github/workflows/render.yml, p. ej. "tu-usuario/Atomivid".
GH_WORKER_REPO=
# Opcional — fuerza un worker explícito en vez del auto-detectado:
# RENDER_WORKER=github-actions|inline
RENDER_WORKER=

# Ensamblado de video (Remotion). Necesita Chromium para renderizar.
# Deja estas dos vacías para que Remotion use/descargue su propio Chromium.
# Solo configúralas si quieres apuntar a un Chromium ya instalado (por
# ejemplo el que usa Playwright) — en Chrome >= 132 el "old headless mode"
# fue removido, así que si usas un binario headless_shell, combínalo con
# REMOTION_CHROME_MODE=headless-shell.
REMOTION_BROWSER_EXECUTABLE=
REMOTION_CHROME_MODE=

# Pagos (Stripe). https://dashboard.stripe.com
STRIPE_SECRET_KEY=tu-stripe-secret-key
# Signing secret del webhook (dashboard.stripe.com/webhooks o `stripe listen`).
STRIPE_WEBHOOK_SECRET=tu-stripe-webhook-secret
# Price ID del plan mensual (Product catalog → tu producto → precio recurrente).
STRIPE_PRICE_ID=price_xxx
# URL pública del sitio, usada en los redirect de Checkout/Billing Portal.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional — tope de videos por mes por usuario, incluso con suscripción
# activa (protege los costos variables mientras se valida la demanda).
MONTHLY_VIDEO_LIMIT=30

# --- Tarifas para el costo estimado por video (src/lib/billing/pricing.ts) ---
# Todas opcionales — si no las configuras, se usa un valor por defecto
# aproximado y documentado en pricing.ts. Actualízalas con la tarifa real
# de tu plan en cada proveedor (ver comentarios en pricing.ts para dónde
# consultarla). El costo se guarda por video en la tabla `generation_costs`
# (migración 0008) — no es exacto, es una estimación para comparar el
# costo relativo entre videos.
PRICING_ELEVENLABS_USD_PER_1K_CHARS=
PRICING_SCRIPT_INPUT_USD_PER_1M_TOKENS=
PRICING_SCRIPT_OUTPUT_USD_PER_1M_TOKENS=
PRICING_RENDER_USD_PER_MINUTE=
