NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role key de Supabase (Project Settings → API → service_role).
# NUNCA la expongas al cliente ni la prefijes con NEXT_PUBLIC_. Solo se usa
# en el pipeline de generación de video (servidor).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Guion (Claude / Anthropic). https://console.anthropic.com
ANTHROPIC_API_KEY=tu-anthropic-api-key
# Opcional — modelo usado para generar el guion (por defecto uno económico,
# ver notas de presupuesto en el README).
ANTHROPIC_SCRIPT_MODEL=claude-sonnet-5

# Voz IA (ElevenLabs). https://elevenlabs.io
ELEVENLABS_API_KEY=tu-elevenlabs-api-key
# Opcional — ID de una voz de tu cuenta de ElevenLabs (por defecto "Mateo",
# voz masculina en español latinoamericano de la Voice Library, elegida
# tras una prueba A/B real — ver scripts/elevenlabs-ab-test.ts). Las voces
# de la Voice Library requieren plan de pago (Starter o superior) para
# usarse por API.
ELEVENLABS_VOICE_ID=uYlzyj2kIZo3HfBB21vF
# Opcional — voces específicas por idioma (el usuario elige español/inglés
# en /dashboard/new). Configura estas si quieres una voz distinta a la de
# defecto en inglés. Si no las configuras, cae a ELEVENLABS_VOICE_ID
# (Mateo, nativo en español) en ambos idiomas.
ELEVENLABS_VOICE_ID_ES=
ELEVENLABS_VOICE_ID_EN=
# Opcional — modelo de ElevenLabs (por defecto Multilingual v2, elegido
# por naturalidad/expresividad tras la prueba A/B real).
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Footage/imágenes (Pexels, banco gratuito). https://www.pexels.com/api
PEXELS_API_KEY=tu-pexels-api-key

# Música de fondo: ni Pixabay Music ni Freesound tienen hoy una API lista
# para uso comercial sin pasos extra (ver README → "Música de fondo").
# Deja vacío para usar el proveedor "fixture" (tono suave generado, sin
# licencia real). Como alternativa real y gratuita: descarga manualmente
# varias pistas de Pixabay Music o Mixkit (ambas permiten uso comercial sin
# costo) y regístralas con su metadata (autor/licencia/tono) en
# src/lib/providers/music/manifest.ts (MUSIC_MANIFEST) — habilita
# selección inteligente por tono (ver providers/music/tone.ts). Si prefieres
# arrancar más rápido sin metadata/tono, sube las pistas a tu bucket de
# Supabase Storage (u otra URL pública) y apunta MUSIC_TRACK_URLS a la
# lista separada por comas — o MUSIC_TRACK_URL para una sola pista fija.
MUSIC_TRACK_URL=
MUSIC_TRACK_URLS=

# --- Proveedores de cada etapa del pipeline ---
# Cada etapa (guion/voz/footage/música) tiene un proveedor "real" (llama a
# la API externa) y uno "fixture" (determinístico, sin red — útil para
# probar todo el flujo sin claves, ver `npm run test:pipeline`).
# Por defecto se auto-detecta: si falta la API key correspondiente, usa el
# fixture automáticamente. Fuerza uno explícitamente si lo necesitas:
# SCRIPT_PROVIDER=anthropic|fixture
# VOICE_PROVIDER=elevenlabs|fixture
# FOOTAGE_PROVIDER=pexels|fixture
# MUSIC_PROVIDER=curated-library|fixture ("custom" sigue aceptado como alias)
SCRIPT_PROVIDER=
VOICE_PROVIDER=
FOOTAGE_PROVIDER=
MUSIC_PROVIDER=

# --- Worker de render en segundo plano ---
# El render (voz/footage/música/ensamblado) puede tardar más que el límite
# de una función serverless. Por defecto se dispara un workflow de GitHub
# Actions (.github/workflows/render.yml) que hace el trabajo pesado fuera
# de Vercel; si faltan estas dos variables, cae automáticamente al worker
# "inline" (corre en el mismo proceso — solo para desarrollo/pruebas, ver
# README → "Worker en background").
#
# GH_WORKER_TOKEN: Personal Access Token de GitHub con permiso para
# disparar workflows en este repo (fine-grained: "Actions: Read and
# write"; classic: scope "repo"). NUNCA lo pongas en este archivo — solo
# en las variables de entorno de Vercel.
GH_WORKER_TOKEN=
# GH_WORKER_REPO: "owner/repo" del repositorio donde vive
# .github/workflows/render.yml, p. ej. "tu-usuario/Atomivid".
GH_WORKER_REPO=
# Opcional — fuerza un worker explícito en vez del auto-detectado:
# RENDER_WORKER=github-actions|inline
RENDER_WORKER=

# Ensamblado de video (Remotion). Necesita Chromium para renderizar.
# Deja estas dos vacías para que Remotion use/descargue su propio Chromium.
# Solo configúralas si quieres apuntar a un Chromium ya instalado (por
# ejemplo el que usa Playwright) — en Chrome >= 132 el "old headless mode"
# fue removido, así que si usas un binario headless_shell, combínalo con
# REMOTION_CHROME_MODE=headless-shell.
REMOTION_BROWSER_EXECUTABLE=
REMOTION_CHROME_MODE=

# Pagos (Stripe). https://dashboard.stripe.com
STRIPE_SECRET_KEY=tu-stripe-secret-key
# Signing secret del webhook (dashboard.stripe.com/webhooks o `stripe listen`).
STRIPE_WEBHOOK_SECRET=tu-stripe-webhook-secret
# Price ID del plan mensual (Product catalog → tu producto → precio recurrente).
STRIPE_PRICE_ID=price_xxx
# URL pública del sitio, usada en los redirect de Checkout/Billing Portal.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional — tope de videos por mes por usuario, incluso con suscripción
# activa (protege los costos variables mientras se valida la demanda).
MONTHLY_VIDEO_LIMIT=30

# --- Tarifas para el costo estimado por video (src/lib/billing/pricing.ts) ---
# Todas opcionales — si no las configuras, se usa un valor por defecto
# aproximado y documentado en pricing.ts. Actualízalas con la tarifa real
# de tu plan en cada proveedor (ver comentarios en pricing.ts para dónde
# consultarla). El costo se guarda por video en la tabla `generation_costs`
# (migración 0008) — no es exacto, es una estimación para comparar el
# costo relativo entre videos.
PRICING_ELEVENLABS_USD_PER_1K_CHARS=
PRICING_SCRIPT_INPUT_USD_PER_1M_TOKENS=
PRICING_SCRIPT_OUTPUT_USD_PER_1M_TOKENS=
PRICING_RENDER_USD_PER_MINUTE=
# USD por pista de música usada. 0 por defecto (la biblioteca curada es
# gratis bajo sus licencias) — solo tiene sentido configurarla si en el
# futuro se conecta un proveedor de música de pago.
PRICING_MUSIC_USD_PER_TRACK=

# --- Visual Director: storyboard semántico + imagen/video/música generados ---
# Todo apagado por defecto — el pipeline actual (Pexels/Pixabay) sigue
# funcionando igual sin nada de esto configurado. Ver docs/VISUAL_DIRECTOR.md
# para la guía completa de activación, costos y caveats de cada proveedor
# (el modelo/precio de OpenAI/Runway/Beatoven no se pudo verificar contra
# documentación oficial primaria en este entorno — confírmalo tú antes de
# activar con una clave real).
VISUAL_DIRECTOR_ENABLED=false
ANTHROPIC_VISUAL_DIRECTOR_MODEL=claude-sonnet-5

IMAGE_PROVIDER=fixture
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_ESTIMATED_COST_USD=0.05

VIDEO_PROVIDER=fixture
PREMIUM_CLIPS_ENABLED=false
RUNWAY_API_KEY=
RUNWAY_MODEL=gen4_turbo
RUNWAY_COST_USD_PER_SECOND=0.05

BEATOVEN_API_KEY=
BEATOVEN_ESTIMATED_COST_USD=0

VISUAL_QA_ENABLED=false
MAX_PREMIUM_CLIPS=1
MAX_PREMIUM_CLIP_SECONDS=5
MAX_VISUAL_COST_USD=1
MAX_PREMIUM_VIDEO_COST_USD=1
MAX_MUSIC_COST_USD=1

# Planificador visual (imagen generada por escena) — ver
# docs/VISUAL_RESOURCE_PLANNER.md. Interruptor GLOBAL e independiente de
# VISUAL_DIRECTOR_ENABLED/IMAGE_PROVIDER — los tres deben estar alineados
# para que ocurra una llamada real. Apagado por defecto.
OPENAI_IMAGE_GENERATION_ENABLED=false
MAX_GENERATED_IMAGES_PER_VIDEO=3

# --- Modo Avatar (foto → video hablando) — ver docs/AVATAR_MODE.md ---
# Apagado por defecto — el modo "visual" sigue siendo el único disponible
# sin esto. NI HeyGen NI D-ID se consideran production-ready (ver el
# documento para el detalle) — no actives ninguno con una clave real sin
# leerlo primero.
AVATAR_MODE_ENABLED=false
# Verified owner's app login email, server-only. Empty disables private preparation.
# Preparation never calls a provider; leave AVATAR_MODE_ENABLED=false until approved.
AVATAR_PREPARATION_OWNER_EMAIL=
AVATAR_PROVIDER=heygen
HEYGEN_API_KEY=
HEYGEN_COST_USD_PER_SECOND=0.0385
# D-ID ("Creative Reality Studio") — candidato más fuerte según la
# comparación documentada, pero igual de no verificado contra su
# documentación oficial primaria que HeyGen (ver docs/AVATAR_MODE.md).
DID_API_KEY=
DID_COST_USD_PER_SECOND=0.1
MAX_AVATAR_COST_USD=3
MAX_AVATAR_DURATION_SECONDS=120
# Secreto compartido propio para autenticar el webhook entrante en
# /api/webhooks/avatar/[provider] (nunca la firma del proveedor — no se
# pudo confirmar contra documentación oficial, ver docs/AVATAR_MODE.md).
# Genera un valor aleatorio largo y regístralo también en el proveedor.
AVATAR_WEBHOOK_SECRET=

# --- Aplicación autónoma de migraciones (scripts/apply-supabase-migration.ts) ---
# La service role key de arriba NO alcanza para esto (solo habilita
# PostgREST, sin DDL) — se necesita UNA de estas opciones para que el
# workflow "Aplicar migración de Supabase" pueda aplicar migraciones
# realmente, en vez de solo verificar en modo lectura:
SUPABASE_DB_URL=
# — o, más simple: solo la contraseña de la base de datos (Project
# Settings → Database → Database password — NO es la service role key).
# El project ref se deriva automáticamente de SUPABASE_URL/
# NEXT_PUBLIC_SUPABASE_URL de arriba (ya configurado) — no hace falta
# repetirlo, salvo que quieras ser explícito con SUPABASE_PROJECT_REF.
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=
# Necesaria en la práctica: la conexión DIRECTA (db.<ref>.supabase.co)
# resuelve hoy solo a IPv6, y entornos como GitHub Actions no tienen
# salida IPv6 — la conexión falla antes de autenticar. Usa en su lugar el
# host del Connection Pooler del proyecto (Project Settings → Database →
# Connection Pooler — NO es secreto, es solo un nombre de host, algo como
# "aws-0-<región>.pooler.supabase.com"). Si no lo configuras y la conexión
# directa falla por red, el error incluye un candidato derivado SOLO de
# datos públicos (el prefijo IPv6 del host directo cruzado con el
# ip-ranges.json oficial de AWS) para que lo confirmes — nunca se
# autentica automáticamente contra un host inferido sin esa confirmación
# (ver scripts/lib/discover-pooler.ts). El workflow de GitHub Actions
# (.github/workflows/apply-supabase-migration.yml) ya trae un valor por
# defecto confirmado para este proyecto como input, no como secret, así
# que ahí no hace falta configurar nada — esta variable es solo para
# correr los scripts localmente.
SUPABASE_DB_HOST=

# Monitoreo de errores en producción (Sentry) — https://sentry.io
# Opcional: sin estas variables, Sentry.init() no envía nada (no-op seguro
# en desarrollo). Crea una cuenta/proyecto gratis en sentry.io, tipo
# "Next.js", y copia el DSN de Project Settings → Client Keys (DSN).
# SENTRY_DSN cubre servidor/edge; NEXT_PUBLIC_SENTRY_DSN cubre el
# navegador (necesita el prefijo NEXT_PUBLIC_ para llegar al bundle
# cliente) — normalmente son el mismo valor.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Opcionales — solo necesarios para que el build suba sourcemaps (mensajes
# de error legibles en vez de código minificado). Sin SENTRY_AUTH_TOKEN el
# build sigue funcionando normal, solo sin sourcemaps. El token se crea en
# sentry.io → Settings → Auth Tokens (permiso project:releases).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SUPABASE_DB_PORT=
